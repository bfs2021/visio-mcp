{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "Canonical diagram document (schema version 1)",
  "description": "Library-independent canonical model. Points (1/72 inch), origin top-left, y down, rotation clockwise about the element centre. This file is the single source for the TypeScript and C# DTOs (tools/generate-contracts.mjs).",
  "$ref": "#/$defs/DiagramDocument",
  "$defs": {
    "Uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "Colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "Point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "Bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } }
    },
    "NonePaint": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": { "kind": { "const": "none" } }
    },
    "SolidPaint": {
      "type": "object", "additionalProperties": false, "required": ["kind", "colour", "opacity"],
      "properties": {
        "kind": { "const": "solid" },
        "colour": { "$ref": "#/$defs/Colour" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "GradientStop": {
      "type": "object", "additionalProperties": false, "required": ["offset", "colour", "opacity"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "colour": { "$ref": "#/$defs/Colour" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "LinearGradientPaint": {
      "description": "A fill that blends between 2 to 8 colour stops along a straight line across the shape. angleDeg 0 runs left to right, 90 top to bottom (clockwise as seen on screen). Offsets rise from 0 to 1. Fills only: strokes and page backgrounds are solid or none.",
      "type": "object", "additionalProperties": false, "required": ["kind", "angleDeg", "stops"],
      "properties": {
        "kind": { "const": "linear-gradient" },
        "angleDeg": { "type": "number", "minimum": -360, "maximum": 360 },
        "stops": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/GradientStop" } }
      }
    },
    "Paint": {
      "oneOf": [{ "$ref": "#/$defs/NonePaint" }, { "$ref": "#/$defs/SolidPaint" }, { "$ref": "#/$defs/LinearGradientPaint" }],
      "x-discriminator": "kind"
    },
    "Guide": {
      "type": "object", "additionalProperties": false, "required": ["id", "orientation", "positionPt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "orientation": { "enum": ["horizontal", "vertical"] },
        "positionPt": { "type": "number" }
      }
    },
    "Grid": {
      "type": "object", "additionalProperties": false, "required": ["visible", "spacingPt", "snap"],
      "properties": { "visible": { "type": "boolean" }, "spacingPt": { "type": "number", "exclusiveMinimum": 0 }, "snap": { "type": "boolean" } }
    },
    "Layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "visible", "locked", "printable", "snap", "glue"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "printable": { "type": "boolean" },
        "snap": { "type": "boolean" },
        "glue": { "type": "boolean" },
        "colourOverride": { "$ref": "#/$defs/Colour" }
      }
    },
    "Asset": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "mimeType", "sha256", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "maxLength": 256 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/bmp", "image/svg+xml"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourcePath": { "type": "string", "maxLength": 1024 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 64 },
        "provenance": { "type": "string", "maxLength": 1024 }
      }
    },
    "TextBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "fontFamily", "fontSizePt", "bold", "italic", "underline", "colour", "horizontalAlign", "verticalAlign", "wrap", "paddingPt"],
      "properties": {
        "value": { "type": "string", "maxLength": 65536 },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontSizePt": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "colour": { "$ref": "#/$defs/Colour" },
        "horizontalAlign": { "enum": ["left", "center", "right"] },
        "verticalAlign": { "enum": ["top", "middle", "bottom"] },
        "wrap": { "type": "boolean" },
        "paddingPt": { "type": "number", "minimum": 0 },
        "insetsPt": { "$ref": "#/$defs/TextInsets", "description": "per-side text margins; when present they replace paddingPt" },
        "orientation": { "enum": ["horizontal", "vertical"], "description": "vertical reads bottom to top; absent means horizontal" }
      }
    },
    "TextInsets": {
      "type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 2000 }, "right": { "type": "number", "minimum": 0, "maximum": 2000 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 2000 }, "left": { "type": "number", "minimum": 0, "maximum": 2000 }
      }
    },
    "ShapeStyle": {
      "type": "object", "additionalProperties": false, "required": ["fill", "stroke", "strokeWidthPt", "dash", "lineCap", "lineJoin"],
      "properties": {
        "fill": { "$ref": "#/$defs/Paint" },
        "stroke": { "$ref": "#/$defs/Paint" },
        "strokeWidthPt": { "type": "number", "minimum": 0 },
        "dash": { "enum": ["solid", "dashed", "dotted", "dash-dot"] },
        "lineCap": { "enum": ["butt", "round", "square"] },
        "lineJoin": { "enum": ["miter", "round", "bevel"] }
      }
    },
    "LineStyle": {
      "type": "object", "additionalProperties": false, "required": ["colour", "widthPt", "dash", "startArrow", "endArrow"],
      "properties": {
        "colour": { "$ref": "#/$defs/Colour" },
        "widthPt": { "type": "number", "minimum": 0 },
        "dash": { "enum": ["solid", "dashed", "dotted", "dash-dot"] },
        "startArrow": { "enum": ["none", "block", "open", "diamond", "oval"] },
        "endArrow": { "enum": ["none", "block", "open", "diamond", "oval"] },
        "startArrowSize": { "enum": ["small", "medium", "large"], "description": "absent means medium" },
        "endArrowSize": { "enum": ["small", "medium", "large"], "description": "absent means medium" }
      }
    },
    "Port": {
      "type": "object", "additionalProperties": false, "required": ["id", "x", "y"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "x": { "type": "number", "minimum": 0, "maximum": 1, "description": "fraction of width, element-local, unrotated" },
        "y": { "type": "number", "minimum": 0, "maximum": 1, "description": "fraction of height, element-local, unrotated" }
      }
    },
    "PathAnchor": {
      "type": "object", "additionalProperties": false, "required": ["position", "offsetPt"],
      "description": "A place along a connector's drawn route: position is the fraction of the route's length from its start (0 start, 0.5 middle, 1 end); offsetPt is the distance to the right of the direction of travel (negative is left).",
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "offsetPt": { "type": "number", "minimum": -2000, "maximum": 2000 }
      }
    },
    "Attachment": {
      "type": "object", "additionalProperties": false, "required": ["connectorId", "position", "offsetPt"],
      "description": "Pins an element's centre to a place along a connector's route. The element follows the connector when its endpoints move or it is rerouted; its bounds are kept in step by the editor.",
      "properties": {
        "connectorId": { "$ref": "#/$defs/Uuid" },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "offsetPt": { "type": "number", "minimum": -2000, "maximum": 2000 }
      }
    },
    "ShapeGeometry": {
      "type": "object", "additionalProperties": false, "required": [],
      "properties": {
        "preset": { "enum": ["rectangle", "rounded-rectangle", "ellipse", "diamond", "triangle", "hexagon", "parallelogram", "cylinder", "cloud", "callout", "terminator", "stored-data", "document", "lined-document"] },
        "svgPath": { "type": "string", "maxLength": 65536 },
        "cornerRadiusPt": { "type": "number", "minimum": 0 }
      }
    },
    "Endpoint": {
      "type": "object", "additionalProperties": false, "required": ["glue"],
      "properties": {
        "elementId": { "$ref": "#/$defs/Uuid" },
        "port": { "type": "string", "minLength": 1, "maxLength": 64 },
        "point": { "$ref": "#/$defs/Point" },
        "glue": { "enum": ["dynamic", "static", "none"] }
      }
    },
    "ShapeElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "layerIds", "zIndex", "locked", "hidden", "bounds", "rotationDeg", "metadata", "geometry", "style"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "kind": { "const": "shape" },
        "layerIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "zIndex": { "type": "integer" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/Bounds" },
        "rotationDeg": { "type": "number" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "geometry": { "$ref": "#/$defs/ShapeGeometry" },
        "style": { "$ref": "#/$defs/ShapeStyle" },
        "text": { "$ref": "#/$defs/TextBlock" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/Port" }, "maxItems": 64 },
        "attachment": { "$ref": "#/$defs/Attachment" }
      }
    },
    "TextElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "layerIds", "zIndex", "locked", "hidden", "bounds", "rotationDeg", "metadata", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "kind": { "const": "text" },
        "layerIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "zIndex": { "type": "integer" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/Bounds" },
        "rotationDeg": { "type": "number" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "text": { "$ref": "#/$defs/TextBlock" },
        "attachment": { "$ref": "#/$defs/Attachment" }
      }
    },
    "ImageElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "layerIds", "zIndex", "locked", "hidden", "bounds", "rotationDeg", "metadata", "assetId", "fit", "opacity", "preserveAspectRatio"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "kind": { "const": "image" },
        "layerIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "zIndex": { "type": "integer" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/Bounds" },
        "rotationDeg": { "type": "number" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "fit": { "enum": ["contain", "cover", "stretch"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "preserveAspectRatio": { "type": "boolean" }
      }
    },
    "ConnectorElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "layerIds", "zIndex", "locked", "hidden", "bounds", "rotationDeg", "metadata", "from", "to", "route", "waypoints", "style"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "kind": { "const": "connector" },
        "layerIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "zIndex": { "type": "integer" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/Bounds" },
        "rotationDeg": { "type": "number" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "from": { "$ref": "#/$defs/Endpoint" },
        "to": { "$ref": "#/$defs/Endpoint" },
        "route": { "enum": ["straight", "orthogonal", "curved"] },
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/Point" }, "maxItems": 256 },
        "style": { "$ref": "#/$defs/LineStyle" },
        "label": { "$ref": "#/$defs/TextBlock" },
        "labelAnchor": { "$ref": "#/$defs/PathAnchor", "description": "where the label sits along the route; absent means the middle, on the line" }
      }
    },
    "GroupElement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "layerIds", "zIndex", "locked", "hidden", "bounds", "rotationDeg", "metadata", "childIds"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "kind": { "const": "group" },
        "layerIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true },
        "zIndex": { "type": "integer" },
        "locked": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "bounds": { "$ref": "#/$defs/Bounds" },
        "rotationDeg": { "type": "number" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "childIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "uniqueItems": true }
      }
    },
    "Element": {
      "oneOf": [
        { "$ref": "#/$defs/ShapeElement" },
        { "$ref": "#/$defs/TextElement" },
        { "$ref": "#/$defs/ImageElement" },
        { "$ref": "#/$defs/ConnectorElement" },
        { "$ref": "#/$defs/GroupElement" }
      ],
      "x-discriminator": "kind"
    },
    "Page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "widthPt", "heightPt", "background", "grid", "guides", "layers", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "widthPt": { "type": "number", "exclusiveMinimum": 0, "maximum": 14400 },
        "heightPt": { "type": "number", "exclusiveMinimum": 0, "maximum": 14400 },
        "background": { "$ref": "#/$defs/Paint" },
        "grid": { "$ref": "#/$defs/Grid" },
        "guides": { "type": "array", "items": { "$ref": "#/$defs/Guide" }, "maxItems": 256 },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/Layer" }, "maxItems": 256 },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/Element" }, "maxItems": 20000 }
      }
    },
    "DocumentSource": {
      "type": "object", "additionalProperties": false, "required": ["format"],
      "properties": { "format": { "enum": ["vsdx", "native-json"] }, "path": { "type": "string", "maxLength": 1024 } }
    },
    "DiagramDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "title", "revision", "pages", "assets", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/Uuid" },
        "title": { "type": "string", "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/Page" }, "minItems": 1, "maxItems": 1000 },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/Asset" }, "maxItems": 10000 },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "source": { "$ref": "#/$defs/DocumentSource" }
      }
    }
  }
}
