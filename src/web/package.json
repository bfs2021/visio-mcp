    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@maxgraph/core": "0.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
