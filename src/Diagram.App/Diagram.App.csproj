<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Diagram.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4258.31]" />
    <ProjectReference Include="..\Diagram.Host.Core\Diagram.Host.Core.csproj" />
    <ProjectReference Include="..\Diagram.Ipc\Diagram.Ipc.csproj" />
    <ProjectReference Include="..\Diagram.Visio\Diagram.Visio.csproj" />
  </ItemGroup>
  <!-- The packaged frontend: build it first (npm run build in src/web). It ships beside the executable under web/. -->
  <ItemGroup>
    <Content Include="..\web\dist\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\lucide\LICENSE" Link="licences\Lucide.LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
