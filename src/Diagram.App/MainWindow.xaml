<Window x:Class="Diagram.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Diagram" Width="1280" Height="800" MinWidth="640" MinHeight="400">
    <Grid>
        <wv2:WebView2 x:Name="Web" AllowDrop="True" AllowExternalDrop="False"
                     PreviewDragEnter="OnNativeDragEnter" PreviewDragOver="OnNativeDragOver" PreviewDrop="OnNativeDrop" />
    </Grid>
</Window>
